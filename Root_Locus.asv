% This is a script file to demonstrate the root locus technique of controller design
clc;

% Model of the Plant, Gp
ng = [1]; % no zeros
dg = [1 0.5]; % 1*S + 0.5 = S + 0.5

% Define the controller structure. Gc
ngc = [1]; % No zeros
dgc = [1 0]; % Pole at S = 0 ie integrator only

% Define the Transfer Function H
nh = [1];
dh = [1];

% Loop transfer function. Gc.Gp.H
nl = conv(conv(ng,ngc),nh);
dl = conv(conv(dg,dgc),dh);

[k,p] = rlocfind(nl,dl)
[nc,dc] = feedback(conv(ng,ngc)*k, )